# Supabase — service role ключ, НЕ anon. Никогда не должен уйти в браузер.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Публичные — ЭТИ можно и нужно светить в браузере (anon-ключ сам по себе
# ничего чувствительного не даёт, RLS на clients уже закрыт полностью).
# Нужны только для прямой загрузки .exe в Storage по подписанной ссылке
# (см. app/admin/page.tsx -> ReleasesPanel).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Логин админа — сгенерировано через scripts/setup-admin.mjs
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=

# Подпись сессионной cookie
SESSION_SECRET=
